# Environment Configuration for StudyGenie Backend

# Mistral AI API Key (Get from https://console.mistral.ai)
MISTRAL_API_KEY=your_mistral_api_key_here

# Database URL
# For PostgreSQL: postgresql://postgres:password@localhost:5432/studygenie
# For SQLite fallback (default out of the box): sqlite:///./data/studygenie.db
DATABASE_URL=sqlite:///./data/studygenie.db

# JWT Authentication
JWT_SECRET_KEY=studygenie_super_secret_jwt_key_2026_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ChromaDB Vector Store Directory
CHROMA_DB_DIR=./chroma_data

# Uploads directory
UPLOAD_DIR=./uploads
